{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EW Technical Knowledge Contract",
  "description": "Proposed schema v0.1; independent of EFD 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "knowledgeId",
    "title",
    "source",
    "claims",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ew-knowledge-0.1"
    },
    "contractType": {
      "const": "technical_knowledge"
    },
    "knowledgeId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "equipmentIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "title"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "statement",
          "verificationStatus",
          "sourceAnchors"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verificationStatus": {
            "enum": [
              "unverified",
              "reviewed",
              "rejected"
            ]
          },
          "sourceAnchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locator"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "relatedTaskIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedSkillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "pending_review",
            "approved",
            "revoked",
            "superseded"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reviewerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
